# rem is the graph's size, on subtitles and labels too.
graph layout=row
css { graph { font-size: 20px; } node { font-size: 30px; } sub { font-size: 0.5rem; } label { font-size: 0.6rem; } }
a "A" sub="s"
b "B"
a -> b "l"
